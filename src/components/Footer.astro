---
import { metaData } from "../config";

const YEAR = new Date().getFullYear();
---

<small class="block lg:mt-10 mt-6 text-[#1C1C1C] dark:text-[#D4D4D4]">
  <time>© {YEAR}</time>{" "}
  <a
    class="tracking-wide no-underline hover:opacity-80 transition-opacity"
    href="/">
    {metaData.title}
  </a>
  
  <div class="float-right transition-opacity duration-300 hover:opacity-90 flex items-center">
    <a 
      href="https://forms.gle/dEkYCg1qyata5EHA8" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Contact"
      class="flex items-center">
      
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        width="18" 
        height="18" 
        viewBox="0 0 24 24" 
        fill="none" 
        stroke="currentColor" 
        stroke-width="2" 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        class="text-[#1c1c1c] dark:text-[#D4D4D4]">
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      
    </a>
  </div>
</small>

<style>
  @media screen and (max-width: 480px) {
    article {
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
  }
</style>